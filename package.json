{
  "name": "survival-party",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
